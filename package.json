{
  "name": "obsff-generador",
  "productName": "Generador OBS FF",
  "version": "1.0.0",
  "description": "Generador de PlayerNameOverwrite.json para OBS Free Fire",
  "author": "OBS FF",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.obsff.generador",
    "productName": "Generador OBS FF",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json", "www/**/*"],
    "win": { "icon": "www/icons/icon-512.png", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
